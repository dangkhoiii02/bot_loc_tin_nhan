# ── Bot Configuration ──
# Create a copy of this file as .env and fill in your values.
# NEVER commit .env to version control!

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=

# Ngrok Authtoken (from https://dashboard.ngrok.com/get-started/your-authtoken)
NGROK_AUTHTOKEN=

# Webhook settings
WEBHOOK_PORT=5001
WEBHOOK_SECRET=

# Flask settings
FLASK_PORT=5000
FLASK_DEBUG=false
